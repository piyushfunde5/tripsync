generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Trip {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String    @unique @db.VarChar(100)
  title         String    @db.VarChar(255)
  destination   String?   @db.VarChar(255)
  description   String?
  startDate     DateTime? @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  rsvpDeadline  DateTime? @map("rsvp_deadline") @db.Timestamptz()
  budgetMin     Int?      @map("budget_min")
  budgetMax     Int?      @map("budget_max")
  status        String    @default("planning") @db.VarChar(20)
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  members        Member[]
  polls          Poll[]
  decisions      Decision[]
  tasks          Task[]
  itineraryItems ItineraryItem[]
  expenses       Expense[]
  activityLog    ActivityLog[]
  emailNotifications EmailNotification[]
  groupFund      GroupFund?

  @@map("trips")
}

model Member {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId          String    @map("trip_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String    @db.VarChar(100)
  email           String    @db.VarChar(255)
  avatarUrl       String?   @map("avatar_url") @db.VarChar(500)
  role            String    @default("member") @db.VarChar(20)
  rsvpStatus      String    @default("pending") @map("rsvp_status") @db.VarChar(20)
  rsvpRespondedAt DateTime? @map("rsvp_responded_at") @db.Timestamptz()
  budgetMin       Int?      @map("budget_min")
  budgetMax       Int?      @map("budget_max")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  trip              Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdPolls      Poll[]             @relation("PollCreator")
  pollVotes         PollVote[]
  createdTasks      Task[]             @relation("TaskCreator")
  assignedTasks     Task[]             @relation("TaskAssignee")
  paidExpenses      Expense[]
  expenseSplits     ExpenseSplit[]
  activityLog       ActivityLog[]
  emailNotifications EmailNotification[]
  fundContributions FundContribution[]
  fundExpenses      FundExpense[]
  treasurerOf       GroupFund[]

  @@unique([tripId, userId])
  @@map("members")
}

model Poll {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  question  String   @db.VarChar(500)
  pollType  String   @default("single") @map("poll_type") @db.VarChar(20)
  deadline  DateTime @db.Timestamptz()
  status    String   @default("open") @db.VarChar(20)
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  trip      Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator   Member       @relation("PollCreator", fields: [createdBy], references: [id])
  options   PollOption[]
  votes     PollVote[]
  decisions Decision[]

  @@map("polls")
}

model PollOption {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pollId      String @map("poll_id") @db.Uuid
  label       String @db.VarChar(255)
  description String?
  imageUrl    String? @map("image_url") @db.VarChar(500)
  sortOrder   Int     @default(0) @map("sort_order")

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@map("poll_options")
}

model PollVote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pollId    String   @map("poll_id") @db.Uuid
  optionId  String   @map("option_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  member Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([pollId, memberId])
  @@map("poll_votes")
}

model Decision {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId       String    @map("trip_id") @db.Uuid
  title        String    @db.VarChar(255)
  category     String?   @db.VarChar(50)
  status       String    @default("proposed") @db.VarChar(20)
  decidedValue String?   @map("decided_value")
  pollId       String?   @map("poll_id") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  trip Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  poll Poll? @relation(fields: [pollId], references: [id])

  @@map("decisions")
}

model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId      String    @map("trip_id") @db.Uuid
  title       String    @db.VarChar(255)
  description String?
  assignedTo  String?   @map("assigned_to") @db.Uuid
  deadline    DateTime? @db.Timestamptz()
  status      String    @default("assigned") @db.VarChar(20)
  createdBy   String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator  Member  @relation("TaskCreator", fields: [createdBy], references: [id])
  assignee Member? @relation("TaskAssignee", fields: [assignedTo], references: [id])

  @@map("tasks")
}

model ItineraryItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  dayNumber   Int      @map("day_number")
  title       String   @db.VarChar(255)
  description String?
  location    String?  @db.VarChar(255)
  startTime   DateTime? @map("start_time") @db.Time()
  endTime     DateTime? @map("end_time") @db.Time()
  category    String?  @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("itinerary_items")
}

model Expense {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  description String   @db.VarChar(255)
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("INR") @db.VarChar(3)
  category    String?  @db.VarChar(50)
  paidBy      String   @map("paid_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  trip   Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payer  Member         @relation(fields: [paidBy], references: [id])
  splits ExpenseSplit[]

  @@map("expenses")
}

model ExpenseSplit {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expenseId   String  @map("expense_id") @db.Uuid
  memberId    String  @map("member_id") @db.Uuid
  shareAmount Decimal @map("share_amount") @db.Decimal(10, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("expense_splits")
}

model GroupFund {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId          String  @unique @map("trip_id") @db.Uuid
  targetPerPerson Decimal? @map("target_per_person") @db.Decimal(10, 2)
  treasurerId     String? @map("treasurer_id") @db.Uuid
  isActive        Boolean @default(false) @map("is_active")

  trip          Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  treasurer     Member?            @relation(fields: [treasurerId], references: [id])
  contributions FundContribution[]
  expenses      FundExpense[]

  @@map("group_fund")
}

model FundContribution {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fundId        String   @map("fund_id") @db.Uuid
  memberId      String   @map("member_id") @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  contributedAt DateTime @default(now()) @map("contributed_at") @db.Timestamptz()

  fund   GroupFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  member Member   @relation(fields: [memberId], references: [id])

  @@map("fund_contributions")
}

model FundExpense {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fundId      String   @map("fund_id") @db.Uuid
  description String   @db.VarChar(255)
  amount      Decimal  @db.Decimal(10, 2)
  category    String?  @db.VarChar(50)
  loggedBy    String   @map("logged_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  fund   GroupFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  logger Member   @relation(fields: [loggedBy], references: [id])

  @@map("fund_expenses")
}

model ActivityLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId       String   @map("trip_id") @db.Uuid
  memberId     String?  @map("member_id") @db.Uuid
  actionType   String   @map("action_type") @db.VarChar(50)
  actionDetail Json?    @map("action_detail")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  trip   Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id])

  @@map("activity_log")
}

model EmailNotification {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId            String   @map("trip_id") @db.Uuid
  recipientEmail    String   @map("recipient_email") @db.VarChar(255)
  recipientMemberId String?  @map("recipient_member_id") @db.Uuid
  notificationType  String   @map("notification_type") @db.VarChar(50)
  subject           String?  @db.VarChar(500)
  sentAt            DateTime @default(now()) @map("sent_at") @db.Timestamptz()
  status            String   @default("sent") @db.VarChar(20)

  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  recipient Member? @relation(fields: [recipientMemberId], references: [id])

  @@map("email_notifications")
}
